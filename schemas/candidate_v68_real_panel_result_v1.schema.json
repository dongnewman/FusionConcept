{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/candidate_v68_real_panel_result_v1.schema.json",
  "title": "Candidate v68 real-panel audit result v1",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "panel_id",
    "panel_source_hash",
    "required_residual_obligations",
    "entries",
    "route_summaries",
    "complete_c2_acceptance",
    "routing_basis",
    "claim_boundary",
    "deterministic_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "candidate_v68_real_panel_v1"},
    "panel_id": {"const": "candidate_v68_real_panel_v1"},
    "panel_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_residual_obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["panel_entry_id", "candidate_id", "candidate_binding_hash", "route", "control_role", "status", "classification_code", "source_audits", "obligation_audits", "v68_execution_authorized", "complete_c2_result", "routing_projection_hash", "result_hash"],
        "properties": {
          "panel_entry_id": {"type": "string"},
          "candidate_id": {"type": "string"},
          "candidate_binding_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "route": {"enum": ["closed_flux", "open_flux"]},
          "control_role": {"enum": ["positive_control", "candidate", "negative_control"]},
          "status": {"enum": ["pass", "fail", "unknown", "unsupported"]},
          "classification_code": {"type": "string"},
          "source_audits": {"type": "array", "items": {"type": "object"}},
          "obligation_audits": {"type": "array", "items": {"type": "object"}},
          "complete_obligations": {"type": "array", "items": {"type": "string"}},
          "incomplete_obligations": {"type": "array", "items": {"type": "string"}},
          "hard_failures": {"type": "array", "items": {"type": "object"}},
          "v68_execution_authorized": {"type": "boolean"},
          "complete_c2_result": {"type": "boolean"},
          "evidence_ceiling": {"type": "string"},
          "routing_projection_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "route_summaries": {"type": "object", "required": ["closed_flux", "open_flux"]},
    "complete_c2_acceptance": {
      "type": "object",
      "required": ["required_per_route", "closed_flux_observed", "open_flux_observed", "passed"]
    },
    "routing_basis": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "deterministic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
