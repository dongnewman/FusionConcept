{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "representative_high_fidelity_v53.schema.json",
  "title": "Representative higher-fidelity validation v53",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "candidate_index", "candidate_id", "physics_hash",
    "validation_profile_ids", "attempts", "attempt_count", "executed_backend_count",
    "status", "parent_synthesized", "promotion_authorized"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_index": {"type": "integer", "minimum": 1},
    "candidate_id": {"type": "string"},
    "physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_profile_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "attempts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route_id", "status", "executed", "applicable", "candidate_c1_evidence_authorized"]
      }
    },
    "status": {
      "enum": [
        "candidate_bound_route_fail",
        "partial_c1_route_pass_deeper_physics_unknown",
        "higher_fidelity_unknown_or_unsupported"
      ]
    },
    "parent_synthesized": {"const": false},
    "promotion_authorized": {"const": false}
  }
}
