{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pleiades WHAM NBI derived Genome V1",
  "type": "object",
  "required": ["schema_version", "stage", "base_design_id", "derived_design_id",
    "base_genome_physics_hash", "derived_genome_physics_hash", "source_artifacts",
    "derivation_audit", "derived_actuator", "declared_problem", "declared_observation",
    "conditional_all_interact_problem", "conditional_all_interact_observation",
    "coupled_balance_proxy_evidence", "coupled_balance_assessment", "summary",
    "claim_ceiling", "claim_boundary", "deterministic_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "pleiades_wham_nbi_derived_genome_v1"},
    "base_design_id": {"const": "pleiades_public_wham_isotropic_regression"},
    "derived_design_id": {"const": "pleiades_wham_nbi_kinetic_control_v1"},
    "base_genome_physics_hash": {"$ref": "#/$defs/hash"},
    "derived_genome_physics_hash": {"$ref": "#/$defs/hash"},
    "source_artifacts": {"type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "object", "required": ["artifact_id", "artifact_hash"],
        "properties": {"artifact_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"$ref": "#/$defs/hash"}}}},
    "derivation_audit": {"type": "object", "required": ["base_unchanged",
      "physics_hash_changed", "validation_valid", "added_actuator_ids", "derivation_hash"],
      "properties": {"base_unchanged": {"const": true},
        "physics_hash_changed": {"const": true}, "validation_valid": {"const": true},
        "added_actuator_ids": {"type": "array", "minItems": 1, "maxItems": 1},
        "derivation_hash": {"$ref": "#/$defs/hash"}}},
    "derived_actuator": {"type": "object", "required": ["id", "kind", "parameters"],
      "properties": {"id": {"const": "wham_25kev_40a_nbi_declaration"},
        "kind": {"const": "neutral_beam"}, "parameters": {"type": "object"}}},
    "declared_problem": {"$ref": "#/$defs/problem"},
    "declared_observation": {"$ref": "#/$defs/observation"},
    "conditional_all_interact_problem": {"$ref": "#/$defs/problem"},
    "conditional_all_interact_observation": {"$ref": "#/$defs/observation"},
    "coupled_balance_proxy_evidence": {"type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "object", "required": ["source_kind", "c2_term_authorized"],
        "properties": {"source_kind": {"const": "proxy"},
          "c2_term_authorized": {"const": false}}}},
    "coupled_balance_assessment": {"type": "object", "required": [
      "c2_authorized_term_count", "complete_c2_balance_authorized", "promotion_authorized"],
      "properties": {"c2_authorized_term_count": {"const": 0},
        "complete_c2_balance_authorized": {"const": false},
        "promotion_authorized": {"const": false}}},
    "summary": {"type": "object", "required": ["base_actuator_count",
      "derived_actuator_count", "physics_hash_changed",
      "actuator_candidate_binding_verified", "mapped_proxy_term_count",
      "c2_authorized_source_term_count", "complete_c2_count", "promotion_count"],
      "properties": {"base_actuator_count": {"const": 0},
        "derived_actuator_count": {"const": 1}, "physics_hash_changed": {"const": true},
        "actuator_candidate_binding_verified": {"const": true},
        "mapped_proxy_term_count": {"const": 2},
        "c2_authorized_source_term_count": {"const": 0},
        "complete_c2_count": {"const": 0}, "promotion_count": {"const": 0}}},
    "claim_ceiling": {"const": "candidate_bound_nbi_declaration_and_incident_ceiling_only"},
    "claim_boundary": {"type": "string", "minLength": 700},
    "deterministic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "problem": {"type": "object", "required": ["actuator_candidate_binding_verified",
      "spectrum_interpretation_verified", "deposition_model_applicability_verified"],
      "properties": {"actuator_candidate_binding_verified": {"const": true},
        "spectrum_interpretation_verified": {"const": false},
        "deposition_model_applicability_verified": {"const": false}}},
    "observation": {"type": "object", "required": ["status",
      "physical_source_rate_authorized", "c2_source_term_authorized"],
      "properties": {"status": {"const": "unknown"},
        "physical_source_rate_authorized": {"const": false},
        "c2_source_term_authorized": {"const": false}}}
  }
}
