{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pleiades WHAM NBI source contract V1",
  "type": "object",
  "required": ["schema_version", "stage", "design_id", "genome_physics_hash",
    "source_artifacts", "base_genome_actuator_count", "overlay_integrated_into_genome",
    "declared_problem", "declared_observation",
    "conditional_all_interact_branching_problem",
    "conditional_all_interact_branching_observation",
    "coupled_balance_proxy_evidence", "coupled_balance_assessment", "summary",
    "claim_ceiling", "claim_boundary", "deterministic_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "pleiades_wham_nbi_source_contract_v1"},
    "design_id": {"const": "pleiades_public_wham_isotropic_regression"},
    "genome_physics_hash": {"$ref": "#/$defs/hash"},
    "source_artifacts": {"type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "required": ["artifact_id", "artifact_hash"],
        "properties": {"artifact_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"$ref": "#/$defs/hash"}}}},
    "base_genome_actuator_count": {"const": 0},
    "overlay_integrated_into_genome": {"const": false},
    "declared_problem": {"$ref": "#/$defs/problem"},
    "declared_observation": {"$ref": "#/$defs/observation"},
    "conditional_all_interact_branching_problem": {"$ref": "#/$defs/problem"},
    "conditional_all_interact_branching_observation": {"$ref": "#/$defs/observation"},
    "coupled_balance_proxy_evidence": {"type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "object", "required": ["term_id", "value", "unit",
        "source_kind", "c2_term_authorized"],
        "properties": {"term_id": {"type": "string"}, "value": {"type": "number"},
          "unit": {"const": "s^-1"}, "source_kind": {"const": "proxy"},
          "c2_term_authorized": {"const": false}}}},
    "coupled_balance_assessment": {"type": "object",
      "required": ["observed_term_count", "c2_authorized_term_count",
        "unknown_equation_ids", "complete_c2_balance_authorized", "promotion_authorized"],
      "properties": {"observed_term_count": {"const": 2},
        "c2_authorized_term_count": {"const": 0},
        "unknown_equation_ids": {"type": "array", "minItems": 3, "maxItems": 3},
        "complete_c2_balance_authorized": {"const": false},
        "promotion_authorized": {"const": false}}},
    "summary": {"type": "object", "additionalProperties": false,
      "required": ["incident_particle_rate_ceiling_s", "power_current_relative_mismatch",
        "conditional_all_interact_ionization_branch_fraction",
        "conditional_all_interact_fueled_particle_rate_ceiling_s",
        "conditional_all_interact_charge_exchange_or_nonfuel_rate_s",
        "mapped_proxy_term_count", "c2_authorized_source_term_count",
        "unknown_coupled_equation_count", "complete_c2_count", "promotion_count"],
      "properties": {
        "incident_particle_rate_ceiling_s": {"type": "number", "exclusiveMinimum": 0},
        "power_current_relative_mismatch": {"const": 0},
        "conditional_all_interact_ionization_branch_fraction": {"const": 0.2},
        "conditional_all_interact_fueled_particle_rate_ceiling_s": {"type": "number", "exclusiveMinimum": 0},
        "conditional_all_interact_charge_exchange_or_nonfuel_rate_s": {"type": "number", "exclusiveMinimum": 0},
        "mapped_proxy_term_count": {"const": 2},
        "c2_authorized_source_term_count": {"const": 0},
        "unknown_coupled_equation_count": {"const": 3},
        "complete_c2_count": {"const": 0},
        "promotion_count": {"const": 0}
      }},
    "claim_ceiling": {"const": "published_nbi_incident_and_cross_section_branching_ceiling_only"},
    "claim_boundary": {"type": "string", "minLength": 850},
    "deterministic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "problem": {"type": "object", "required": ["problem_hash",
      "declared_beam_power_w", "primary_particle_energy_j",
      "declared_equivalent_current_a", "injection_pitch_angle_rad",
      "actuator_candidate_binding_verified", "spectrum_interpretation_verified",
      "deposition_model_applicability_verified"],
      "properties": {"problem_hash": {"$ref": "#/$defs/hash"},
        "declared_beam_power_w": {"const": 1000000},
        "primary_particle_energy_j": {"type": "number", "exclusiveMinimum": 0},
        "declared_equivalent_current_a": {"const": 40},
        "injection_pitch_angle_rad": {"type": "number"},
        "actuator_candidate_binding_verified": {"const": false},
        "spectrum_interpretation_verified": {"const": false},
        "deposition_model_applicability_verified": {"const": false}}},
    "observation": {"type": "object", "required": ["problem_hash",
      "power_limited_incident_particle_rate_s", "current_limited_incident_particle_rate_s",
      "incident_particle_rate_ceiling_s", "status", "physical_source_rate_authorized",
      "c2_source_term_authorized", "observation_hash"],
      "properties": {"problem_hash": {"$ref": "#/$defs/hash"},
        "power_limited_incident_particle_rate_s": {"type": "number", "exclusiveMinimum": 0},
        "current_limited_incident_particle_rate_s": {"type": "number", "exclusiveMinimum": 0},
        "incident_particle_rate_ceiling_s": {"type": "number", "exclusiveMinimum": 0},
        "status": {"const": "unknown"},
        "physical_source_rate_authorized": {"const": false},
        "c2_source_term_authorized": {"const": false},
        "observation_hash": {"$ref": "#/$defs/hash"}}}
  }
}
