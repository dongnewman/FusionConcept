{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmc.local/schemas/zpinch_nonideal_electrode_audit_v23.schema.json",
  "title": "Z-pinch non-ideal spectrum and electrode audit v23",
  "type": "object",
  "required": [
    "schema_version", "search_version", "stage", "run_date", "result_hash",
    "input_binding", "audit_contract", "execution", "outcome", "archives",
    "claim_boundary", "promotion_credit", "source_hashes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "search_version": {
      "const": "zpinch_nonideal_electrode_audit_v23"
    },
    "stage": {
      "const": "rejection_and_blocking_unknown_zpinch_admission_audit"
    },
    "result_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claim_boundary": { "type": "string", "minLength": 100 },
    "promotion_credit": {
      "type": "object",
      "required": [
        "medium_fidelity_authorized_count", "physics_evidence_level_change"
      ],
      "properties": {
        "medium_fidelity_authorized_count": { "const": 0 },
        "physics_evidence_level_change": { "const": 0 }
      }
    }
  },
  "additionalProperties": true
}
