{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desc_w7x_periodic_surface_control_v1.schema.json",
  "type": "object",
  "required": ["schema_version", "stage", "design_id", "genome_physics_hash",
    "surface_grid_artifact", "surface_grid_sha256", "source_solver_result_hash",
    "coarse_periodic_surfaces", "fine_periodic_surfaces",
    "two_resolution_convergence", "periodic_surface_evidence_bundle",
    "summary", "threshold_provenance", "claim_boundary", "deterministic_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "desc_w7x_periodic_surface_control_v1"},
    "genome_physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "surface_grid_artifact": {"const": "knowledge/desc_w7x_periodic_surface_grid_v1.json"},
    "surface_grid_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_solver_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {
      "type": "object",
      "required": ["surface_level_count", "coarse_theta_count", "coarse_zeta_count",
        "fine_theta_count", "fine_zeta_count", "coarse_status", "fine_status",
        "two_resolution_status", "maximum_fine_tangency_residual",
        "minimum_fine_signed_jacobian_m3", "maximum_fine_jacobian_relative_error",
        "fine_minimum_normal_nesting_gap_m", "maximum_surface_area_relative_difference",
        "maximum_mean_major_radius_relative_difference",
        "periodic_surface_support_authorized", "covered_topology_domain_count",
        "declared_topology_domain_count", "complete_C1_evidence_authorized",
        "promotion_count"],
      "properties": {
        "surface_level_count": {"const": 4},
        "coarse_theta_count": {"const": 17},
        "coarse_zeta_count": {"const": 9},
        "fine_theta_count": {"const": 33},
        "fine_zeta_count": {"const": 17},
        "coarse_status": {"const": "pass"},
        "fine_status": {"const": "pass"},
        "two_resolution_status": {"const": "pass"},
        "maximum_fine_tangency_residual": {"type": "number", "maximum": 1e-8},
        "minimum_fine_signed_jacobian_m3": {"type": "number", "minimum": 1e-8},
        "maximum_fine_jacobian_relative_error": {"type": "number", "maximum": 1e-8},
        "fine_minimum_normal_nesting_gap_m": {"type": "number", "minimum": 0.01},
        "maximum_surface_area_relative_difference": {"type": "number", "maximum": 0.01},
        "maximum_mean_major_radius_relative_difference": {"type": "number", "maximum": 0.001},
        "periodic_surface_support_authorized": {"const": true},
        "covered_topology_domain_count": {"const": 1},
        "declared_topology_domain_count": {"const": 2},
        "complete_C1_evidence_authorized": {"const": false},
        "promotion_count": {"const": 0}
      }
    },
    "threshold_provenance": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "deterministic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
