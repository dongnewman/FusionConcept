{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pleiades ambipolar response requirement V1",
  "type": "object",
  "required": ["schema_version", "stage", "design_id", "genome_physics_hash",
    "source_artifacts", "problem", "observation", "required_response_contract",
    "summary", "claim_ceiling", "claim_boundary", "deterministic_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "pleiades_ambipolar_response_requirement_v1"},
    "design_id": {"const": "pleiades_wham_nbi_kinetic_control_v1"},
    "genome_physics_hash": {"$ref": "#/$defs/hash"},
    "source_artifacts": {"type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "object", "required": ["artifact_id", "artifact_hash"],
        "properties": {"artifact_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"$ref": "#/$defs/hash"}}}},
    "problem": {"type": "object", "required": ["axial_positions_m",
      "elementary_charge_times_potential_grid_j", "electron_density_response_m3",
      "ion_density_responses_m3", "problem_hash"],
      "properties": {"axial_positions_m": {"type": "array", "minItems": 81, "maxItems": 81},
        "elementary_charge_times_potential_grid_j": {"type": "null"},
        "electron_density_response_m3": {"type": "null"},
        "ion_density_responses_m3": {"type": "object", "maxProperties": 0},
        "problem_hash": {"$ref": "#/$defs/hash"}}},
    "observation": {"type": "object", "required": ["status",
      "numerical_root_complete", "c2_ambipolar_profile_authorized",
      "elementary_charge_times_potential_roots_j", "evidence_tasks", "observation_hash"],
      "properties": {"status": {"const": "unknown"},
        "numerical_root_complete": {"const": false},
        "c2_ambipolar_profile_authorized": {"const": false},
        "elementary_charge_times_potential_roots_j": {"type": "null"},
        "evidence_tasks": {"type": "array", "minItems": 3},
        "observation_hash": {"$ref": "#/$defs/hash"}}},
    "required_response_contract": {"type": "object", "required": [
      "axial_location_count", "minimum_ephi_sample_count", "required_terms"],
      "properties": {"axial_location_count": {"const": 81},
        "minimum_ephi_sample_count": {"const": 3},
        "required_terms": {"type": "array", "minItems": 7}}},
    "summary": {"type": "object", "required": ["axial_location_count",
      "provided_ephi_sample_count", "provided_density_response_tensor_count",
      "numerical_root_complete", "c2_ambipolar_profile_count", "complete_c2_count",
      "promotion_count"], "properties": {"axial_location_count": {"const": 81},
        "provided_ephi_sample_count": {"const": 0},
        "provided_density_response_tensor_count": {"const": 0},
        "numerical_root_complete": {"const": false},
        "c2_ambipolar_profile_count": {"const": 0},
        "complete_c2_count": {"const": 0}, "promotion_count": {"const": 0}}},
    "claim_ceiling": {"const": "candidate_specific_ambipolar_response_problem_definition_only"},
    "claim_boundary": {"type": "string", "minLength": 700},
    "deterministic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
