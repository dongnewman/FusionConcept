{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partial_operator_v2.schema.json",
  "title": "PartialOperatorV2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "form", "inputs", "outputs", "domain_and_time_scope", "dimension_signature",
    "causal_direction", "allowed_conservation_effects", "forbidden_conservation_effects",
    "parameter_bounds", "scale_bounds", "symmetry_or_limit_constraints", "null_models",
    "alternative_models", "identifiability_conditions", "minimum_effect_size",
    "noise_and_numerical_floor", "complexity_budget", "out_of_sample_prediction_refs",
    "failure_scope_options", "safety_limits", "completion_routes", "promotion_scope_ref"
  ],
  "properties": {
    "form": {"const": "partial_operator"},
    "inputs": {"type": "array"},
    "outputs": {"type": "array"},
    "domain_and_time_scope": {"type": "object"},
    "dimension_signature": {"type": ["object", "array", "string"]},
    "causal_direction": {"type": "string", "minLength": 1},
    "allowed_conservation_effects": {"type": "array"},
    "forbidden_conservation_effects": {"type": "array"},
    "parameter_bounds": {"type": "object"},
    "scale_bounds": {"type": "object"},
    "symmetry_or_limit_constraints": {"type": "array"},
    "null_models": {"type": "array", "minItems": 1},
    "alternative_models": {"type": "array", "minItems": 1},
    "identifiability_conditions": {"type": "array", "minItems": 1},
    "minimum_effect_size": {"type": ["number", "object"]},
    "noise_and_numerical_floor": {"type": ["number", "object"]},
    "complexity_budget": {
      "type": "object",
      "required": ["max_free_parameters", "max_free_functions", "max_memory_length", "max_suboperators"]
    },
    "out_of_sample_prediction_refs": {"type": "array", "minItems": 1},
    "failure_scope_options": {"type": "array", "minItems": 1},
    "safety_limits": {"type": "array"},
    "completion_routes": {"type": "array", "minItems": 1},
    "promotion_scope_ref": {"type": "string", "minLength": 1}
  }
}
