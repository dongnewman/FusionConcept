{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconcept.ai/schemas/material_property_manifest_v1.schema.json",
  "title": "MaterialPropertyManifestV1 declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["materials"],
  "properties": {
    "materials": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["material_id", "grade", "version", "data_source_refs", "data_hash", "applicable_property_ids", "properties"],
        "properties": {
          "material_id": {"type": "string", "minLength": 1},
          "grade": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "data_source_refs": {"type": "array", "minItems": 1},
          "data_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "applicable_property_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
          "properties": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["property_id", "unit", "independent_variables", "representation", "curve_data", "validity_ranges", "uncertainty", "source_refs", "data_hash"],
              "properties": {
                "property_id": {"type": "string", "minLength": 1},
                "unit": {"type": "string", "minLength": 1},
                "independent_variables": {
                  "type": "array", "uniqueItems": true,
                  "items": {"enum": ["temperature", "magnetic_field", "strain", "dpa", "helium_production", "cycle_count", "frequency", "pressure"]}
                },
                "representation": {"enum": ["piecewise_linear_table", "polynomial", "spline", "constitutive_operator"]},
                "curve_data": {"type": "object", "minProperties": 1},
                "validity_ranges": {"type": "object"},
                "uncertainty": {"type": "object", "required": ["kind", "value", "unit"]},
                "source_refs": {"type": "array", "minItems": 1},
                "data_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
