{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executable_physics_genome_v1.schema.json",
  "title": "Executable Physics Genome 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_genome_physics_hash", "physics_modules"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "base_genome_physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physics_modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "$defs": {
    "nonempty_strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "domain_ids", "input_ids", "output_ids", "state_variables", "equations", "boundary_conditions", "source_loss_terms", "applicability_scales", "backend_requirements", "dependency_module_ids", "declaration_status", "source_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "role": {"enum": ["field", "topology", "equilibrium", "transport", "stability", "conservation", "production", "engineering", "control", "exhaust", "coupling"]},
        "domain_ids": {"$ref": "#/$defs/nonempty_strings", "minItems": 1},
        "input_ids": {"$ref": "#/$defs/nonempty_strings"},
        "output_ids": {"$ref": "#/$defs/nonempty_strings"},
        "state_variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}},
        "equations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/equation"}},
        "boundary_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundary"}},
        "source_loss_terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/term"}},
        "applicability_scales": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scale"}},
        "backend_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/backend"}},
        "dependency_module_ids": {"$ref": "#/$defs/nonempty_strings"},
        "declaration_status": {"const": "explicit"},
        "source_ids": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "field_type", "domain_ids", "species", "unit", "time_behavior"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "field_type": {"enum": ["scalar", "vector", "tensor", "distribution", "circuit", "geometry"]},
        "domain_ids": {"$ref": "#/$defs/nonempty_strings", "minItems": 1},
        "species": {"$ref": "#/$defs/nonempty_strings"},
        "unit": {"type": "string", "minLength": 1},
        "time_behavior": {"enum": ["static", "steady_state", "transient", "periodic", "event_driven"]}
      }
    },
    "equation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "equation_class", "form", "state_variable_ids", "input_ids", "output_ids", "closure_level", "applicability_conditions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "equation_class": {"enum": ["maxwell", "field_line", "force_balance", "particle_balance", "energy_balance", "momentum_balance", "current_balance", "magnetic_flux_balance", "transport", "stability", "reaction", "radiation", "circuit", "mechanics", "heat_transfer", "control", "geometry"]},
        "form": {"enum": ["pde", "ode", "algebraic", "integral", "eigenproblem", "particle_push", "optimization", "constraint"]},
        "state_variable_ids": {"$ref": "#/$defs/nonempty_strings", "minItems": 1},
        "input_ids": {"$ref": "#/$defs/nonempty_strings"},
        "output_ids": {"$ref": "#/$defs/nonempty_strings", "minItems": 1},
        "closure_level": {"enum": ["first_principles", "reduced_physics", "calibrated_closure", "empirical_prior", "unknown"]},
        "applicability_conditions": {"$ref": "#/$defs/nonempty_strings", "minItems": 1}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "domain_ids", "state_variable_id", "kind", "data_input_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "domain_ids": {"$ref": "#/$defs/nonempty_strings", "minItems": 1},
        "state_variable_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["dirichlet", "neumann", "robin", "periodic", "interface", "open", "absorbing", "conducting", "magnetic_surface", "separatrix", "symmetry", "none"]},
        "data_input_ids": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "term": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "conserved_quantities", "domain_ids", "input_ids", "output_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["source", "loss", "exchange", "none"]},
        "conserved_quantities": {"$ref": "#/$defs/nonempty_strings", "minItems": 1},
        "domain_ids": {"$ref": "#/$defs/nonempty_strings", "minItems": 1},
        "input_ids": {"$ref": "#/$defs/nonempty_strings"},
        "output_ids": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "scale": {
      "type": "object", "additionalProperties": false,
      "required": ["parameter_id", "lower_bound", "upper_bound", "unit", "derivation", "status"],
      "properties": {
        "parameter_id": {"type": "string", "minLength": 1},
        "lower_bound": {"type": ["number", "null"]},
        "upper_bound": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "status": {"enum": ["declared", "derived", "unknown"]}
      }
    },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "implementation_id", "minimum_fidelity", "status", "required_input_ids", "convergence_metric_ids", "uncertainty_output_ids"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "implementation_id": {"type": "string", "minLength": 1},
        "minimum_fidelity": {"type": "integer", "minimum": 0},
        "status": {"enum": ["available", "planned", "blocked"]},
        "required_input_ids": {"$ref": "#/$defs/nonempty_strings"},
        "convergence_metric_ids": {"$ref": "#/$defs/nonempty_strings", "minItems": 1},
        "uncertainty_output_ids": {"$ref": "#/$defs/nonempty_strings", "minItems": 1}
      }
    }
  }
}
