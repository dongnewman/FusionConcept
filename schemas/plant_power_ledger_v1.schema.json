{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/plant_power_ledger_v1.schema.json",
  "title": "PlantPowerLedgerV1",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "physics_hash", "state_result_hash",
    "transport_result_hash", "engineering_result_hash", "coupled_result_hash",
    "time_basis", "plant_roles", "terms", "status", "sign_status", "closure",
    "strict_role_completeness_required", "generated_nominal", "artificially_closed",
    "evidence_ceiling", "ledger_hash", "result_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_result_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "transport_result_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "engineering_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coupled_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time_basis": {"type": "object"},
    "plant_roles": {"type": "array", "items": {"type": "object"}},
    "terms": {"type": "array", "items": {"type": "object"}},
    "gross_electric_power_w": {"type": ["number", "null"]},
    "direct_recovery_power_w": {"type": ["number", "null"]},
    "recirculating_power_w": {"type": ["number", "null"]},
    "reported_net_power_w": {"type": ["number", "null"]},
    "reported_net_power_interpretation": {"type": "string"},
    "status": {"enum": ["complete", "fail", "unknown_incomplete_solver_output_role"]},
    "sign_status": {"type": "string"},
    "closure": {"type": "object"},
    "strict_role_completeness_required": {"const": true},
    "generated_nominal": {"const": false},
    "artificially_closed": {"const": false},
    "closure_tolerance_w": {"type": ["number", "null"]},
    "evidence_ceiling": {"type": "string", "minLength": 1},
    "ledger_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
