{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pleiades bounce-averaged end-loss requirement V1",
  "type": "object",
  "required": ["schema_version", "stage", "design_id", "genome_physics_hash",
    "source_artifacts", "problem", "observation", "coupled_balance_evidence",
    "coupled_balance_assessment", "length_boundary", "required_distribution_contract",
    "summary", "claim_ceiling", "claim_boundary", "deterministic_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "pleiades_bounce_averaged_end_loss_requirement_v1"},
    "design_id": {"const": "pleiades_wham_nbi_kinetic_control_v1"},
    "genome_physics_hash": {"$ref": "#/$defs/hash"},
    "source_artifacts": {"type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "required": ["artifact_id", "artifact_hash"],
        "properties": {"artifact_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"$ref": "#/$defs/hash"}}}},
    "problem": {"type": "object", "required": ["throat_to_throat_length_m",
      "throat_to_throat_length_verified", "bin_particle_inventories",
      "ambipolar_profile_c2_authorized", "problem_hash"],
      "properties": {"throat_to_throat_length_m": {"const": 2},
        "throat_to_throat_length_verified": {"const": false},
        "bin_particle_inventories": {"type": "null"},
        "ambipolar_profile_c2_authorized": {"const": false},
        "problem_hash": {"$ref": "#/$defs/hash"}}},
    "observation": {"type": "object", "required": ["status",
      "parallel_particle_loss_rate_s", "parallel_boundary_kinetic_power_w",
      "c2_physical_end_loss_authorized", "evidence_tasks", "observation_hash"],
      "properties": {"status": {"const": "unknown"},
        "parallel_particle_loss_rate_s": {"type": "null"},
        "parallel_boundary_kinetic_power_w": {"type": "null"},
        "c2_physical_end_loss_authorized": {"const": false},
        "evidence_tasks": {"type": "array", "minItems": 10},
        "observation_hash": {"$ref": "#/$defs/hash"}}},
    "coupled_balance_evidence": {"type": "array", "maxItems": 0},
    "length_boundary": {"type": "object", "required": ["numeric_value_m",
      "verified_as_throat_to_throat_length"],
      "properties": {"numeric_value_m": {"const": 2},
        "verified_as_throat_to_throat_length": {"const": false}}},
    "summary": {"type": "object", "required": [
      "provided_physical_distribution_bin_count", "mapped_balance_term_count",
      "c2_end_loss_term_count", "complete_c2_count", "promotion_count"],
      "properties": {"provided_physical_distribution_bin_count": {"const": 0},
        "mapped_balance_term_count": {"const": 0},
        "c2_end_loss_term_count": {"const": 0},
        "complete_c2_count": {"const": 0}, "promotion_count": {"const": 0}}},
    "claim_ceiling": {"const": "candidate_specific_dimensional_end_loss_problem_definition_only"},
    "claim_boundary": {"type": "string", "minLength": 850},
    "deterministic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
