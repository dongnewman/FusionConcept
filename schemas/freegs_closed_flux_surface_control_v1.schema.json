{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "freegs_closed_flux_surface_control_v1.schema.json",
  "type": "object",
  "required": ["schema_version", "stage", "design_id", "genome_physics_hash",
    "field_grid_artifact", "field_grid_sha256", "coarse_closed_surfaces",
    "fine_closed_surfaces", "two_resolution_convergence",
    "closed_surface_evidence_bundle", "summary", "threshold_provenance",
    "claim_boundary", "deterministic_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "freegs_closed_flux_surface_control_v1"},
    "genome_physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "field_grid_artifact": {"const": "knowledge/freegs_total_field_grid_v1.json"},
    "field_grid_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {
      "type": "object",
      "required": ["surface_level_count", "angular_sample_count_per_surface",
        "coarse_grid_point_count", "fine_grid_point_count", "coarse_status",
        "fine_status", "two_resolution_status", "maximum_coarse_tangency_residual",
        "maximum_fine_tangency_residual", "maximum_mean_radius_relative_difference",
        "maximum_pointwise_radius_relative_difference", "fine_minimum_nesting_gap_m",
        "closed_surface_support_authorized", "complete_C1_evidence_authorized",
        "promotion_count"],
      "properties": {
        "surface_level_count": {"const": 8},
        "angular_sample_count_per_surface": {"const": 72},
        "coarse_grid_point_count": {"const": 1089},
        "fine_grid_point_count": {"const": 4225},
        "coarse_status": {"const": "pass"},
        "fine_status": {"const": "pass"},
        "two_resolution_status": {"const": "pass"},
        "maximum_coarse_tangency_residual": {"type": "number", "maximum": 0.02},
        "maximum_fine_tangency_residual": {"type": "number", "maximum": 0.02},
        "maximum_mean_radius_relative_difference": {"type": "number", "maximum": 0.05},
        "maximum_pointwise_radius_relative_difference": {"type": "number", "maximum": 0.10},
        "fine_minimum_nesting_gap_m": {"type": "number", "minimum": 0.005},
        "closed_surface_support_authorized": {"const": true},
        "complete_C1_evidence_authorized": {"const": false},
        "promotion_count": {"const": 0}
      }
    },
    "threshold_provenance": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "deterministic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
