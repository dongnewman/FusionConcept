{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmc.local/schemas/pleiades_full_loss_cone_streaming_v1.schema.json",
  "title": "Pleiades full-loss-cone streaming ceiling v1",
  "type": "object",
  "required": ["schema_version", "stage", "operator_principle", "design_id",
    "genome_physics_hash", "source_artifacts", "state_source_kind",
    "geometry_candidate_binding_verified", "state_candidate_binding_verified",
    "full_loss_cone_boundary_condition_verified", "observations", "convergence",
    "coupled_balance_proxy_evidence", "coupled_balance_assessment", "summary",
    "claim_ceiling", "claim_boundary", "deterministic_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "pleiades_full_loss_cone_streaming_v1"},
    "operator_principle": {"type": "string", "minLength": 300},
    "design_id": {"const": "pleiades_public_wham_isotropic_regression"},
    "genome_physics_hash": {"$ref": "#/$defs/hash"},
    "source_artifacts": {"type": "array", "minItems": 5, "maxItems": 5,
      "items": {"type": "object", "required": ["artifact_id", "artifact_hash"],
        "properties": {"artifact_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"$ref": "#/$defs/hash"}},
        "additionalProperties": false}},
    "state_source_kind": {"const": "design_assumption"},
    "geometry_candidate_binding_verified": {"const": true},
    "state_candidate_binding_verified": {"const": false},
    "full_loss_cone_boundary_condition_verified": {"const": false},
    "observations": {"type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/observation"}},
    "convergence": {
      "type": "object",
      "required": ["observation_hashes", "total_particle_loss_rates_s",
        "total_energy_loss_powers_w", "particle_adjacent_relative_changes",
        "energy_adjacent_relative_changes", "convergence_limit", "status",
        "c2_boundary_flux_authorized", "convergence_hash"],
      "properties": {
        "observation_hashes": {"type": "array", "minItems": 3, "maxItems": 3,
          "items": {"$ref": "#/$defs/hash"}},
        "total_particle_loss_rates_s": {"type": "array", "minItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}},
        "total_energy_loss_powers_w": {"type": "array", "minItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}},
        "particle_adjacent_relative_changes": {"type": "array", "minItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 0.02}},
        "energy_adjacent_relative_changes": {"type": "array", "minItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 0.02}},
        "convergence_limit": {"const": 0.02},
        "status": {"const": "pass"},
        "c2_boundary_flux_authorized": {"const": false},
        "convergence_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "coupled_balance_proxy_evidence": {"type": "array", "minItems": 3,
      "maxItems": 3, "items": {"type": "object", "required": ["term_id",
        "value", "unit", "source_kind", "c2_term_authorized"],
        "properties": {"source_kind": {"const": "proxy"},
          "c2_term_authorized": {"const": false}}}},
    "coupled_balance_assessment": {"type": "object",
      "required": ["observed_term_count", "c2_authorized_term_count",
        "unknown_equation_ids", "status", "complete_c2_balance_authorized",
        "promotion_authorized"],
      "properties": {"observed_term_count": {"const": 3},
        "c2_authorized_term_count": {"const": 0},
        "unknown_equation_ids": {"type": "array", "minItems": 3, "maxItems": 3},
        "status": {"const": "unknown"},
        "complete_c2_balance_authorized": {"const": false},
        "promotion_authorized": {"const": false}}},
    "summary": {"type": "object",
      "required": ["resolution_count", "numeric_streaming_ceiling_count",
        "fine_total_particle_loss_rate_s", "fine_total_energy_loss_power_w",
        "fine_scalar_thermal_energy_j",
        "fine_streaming_ceiling_energy_depletion_time_s",
        "fine_electron_particle_loss_rate_s",
        "fine_deuterium_particle_loss_rate_s",
        "maximum_adjacent_relative_change", "mapped_coupled_term_count",
        "c2_authorized_coupled_term_count", "unknown_coupled_equation_count",
        "complete_c2_count", "promotion_count"],
      "properties": {
        "resolution_count": {"const": 3},
        "numeric_streaming_ceiling_count": {"const": 3},
        "fine_total_particle_loss_rate_s": {"type": "number", "exclusiveMinimum": 0},
        "fine_total_energy_loss_power_w": {"type": "number", "exclusiveMinimum": 0},
        "fine_scalar_thermal_energy_j": {"type": "number", "exclusiveMinimum": 0},
        "fine_streaming_ceiling_energy_depletion_time_s": {"type": "number", "exclusiveMinimum": 0},
        "maximum_adjacent_relative_change": {"type": "number", "minimum": 0, "maximum": 0.02},
        "mapped_coupled_term_count": {"const": 3},
        "c2_authorized_coupled_term_count": {"const": 0},
        "unknown_coupled_equation_count": {"const": 3},
        "complete_c2_count": {"const": 0},
        "promotion_count": {"const": 0}
      }
    },
    "claim_ceiling": {"const": "C0_full_loss_cone_streaming_ceiling_only"},
    "claim_boundary": {"type": "string", "minLength": 800},
    "deterministic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "speciesState": {"type": "object", "required": ["species_id", "mass_kg",
      "density_m3", "temperature_j", "distribution_kind"],
      "properties": {"mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "density_m3": {"type": "number", "minimum": 0},
        "temperature_j": {"type": "number", "exclusiveMinimum": 0},
        "distribution_kind": {"const": "maxwellian"}}},
    "observation": {"type": "object",
      "required": ["compiler_version", "resolution_label", "resolution_rank",
        "connection_length_m", "effective_volume_m3",
        "effective_midplane_area_m2", "mirror_ratio", "end_count",
        "flux_weighted_loss_cone_transmission", "species_states",
        "species_particle_loss_rates_s", "species_energy_loss_powers_w",
        "total_particle_loss_rate_s", "total_energy_loss_power_w",
        "geometry_candidate_binding_verified", "state_candidate_binding_verified",
        "full_loss_cone_boundary_condition_verified", "status",
        "physical_rate_authorized", "observation_hash"],
      "properties": {
        "compiler_version": {"const": "open_flux_tube_streaming_compiler_v1.0.0"},
        "resolution_rank": {"type": "integer", "minimum": 1, "maximum": 3},
        "connection_length_m": {"type": "number", "exclusiveMinimum": 0},
        "effective_volume_m3": {"type": "number", "exclusiveMinimum": 0},
        "effective_midplane_area_m2": {"type": "number", "exclusiveMinimum": 0},
        "mirror_ratio": {"type": "number", "minimum": 1},
        "end_count": {"const": 2},
        "flux_weighted_loss_cone_transmission": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "species_states": {"type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/speciesState"}},
        "total_particle_loss_rate_s": {"type": "number", "exclusiveMinimum": 0},
        "total_energy_loss_power_w": {"type": "number", "exclusiveMinimum": 0},
        "geometry_candidate_binding_verified": {"const": true},
        "state_candidate_binding_verified": {"const": false},
        "full_loss_cone_boundary_condition_verified": {"const": false},
        "status": {"const": "pass"},
        "physical_rate_authorized": {"const": false},
        "observation_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
