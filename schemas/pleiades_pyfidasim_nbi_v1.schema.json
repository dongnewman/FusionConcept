{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate-bound Pleiades pyFIDASIM NBI attenuation V1",
  "type": "object",
  "required": [
    "schema_version", "runner_version", "status", "design_id",
    "genome_physics_hash", "domain_id", "backend", "source_kind",
    "candidate_binding_verified", "neutral_density_field_computed",
    "ionized_particle_deposition_rate_computed",
    "charge_exchange_sink_rate_computed",
    "nonlinear_multispecies_response_computed", "ambipolar_profile_computed",
    "c2_source_term_authorized", "c2_kinetic_response_authorized",
    "observations", "inventory_relative_change", "gates", "source_artifacts",
    "evidence_tasks", "claim_boundary", "result_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "runner_version": {"const": "pleiades_pyfidasim_nbi_runner_v1.0.0"},
    "status": {"const": "pass"},
    "design_id": {"const": "pleiades_wham_nbi_kinetic_control_v1"},
    "genome_physics_hash": {"$ref": "#/$defs/hash"},
    "domain_id": {"const": "pleiades_wham_isotropic_core"},
    "backend": {
      "type": "object",
      "required": ["repository", "commit", "source_tree_hash", "license_status"],
      "properties": {
        "repository": {"const": "https://github.com/D3DEnergetic/pyFIDASIM"},
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "source_tree_hash": {"$ref": "#/$defs/hash"},
        "license_status": {"const": "no_license_file_observed_at_pinned_commit"}
      }
    },
    "source_kind": {"const": "external_candidate_solver"},
    "candidate_binding_verified": {"const": true},
    "neutral_density_field_computed": {"const": true},
    "ionized_particle_deposition_rate_computed": {"const": false},
    "charge_exchange_sink_rate_computed": {"const": false},
    "nonlinear_multispecies_response_computed": {"const": false},
    "ambipolar_profile_computed": {"const": false},
    "c2_source_term_authorized": {"const": false},
    "c2_kinetic_response_authorized": {"const": false},
    "observations": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["marker_count", "seed", "density_shape",
          "density_nonzero_cell_count", "maximum_neutral_density_cm3",
          "represented_neutral_inventory", "energy_state_inventory",
          "profile_summary"],
        "properties": {
          "marker_count": {"type": "integer", "minimum": 1},
          "density_nonzero_cell_count": {"type": "integer", "minimum": 1},
          "maximum_neutral_density_cm3": {"type": "number", "exclusiveMinimum": 0},
          "represented_neutral_inventory": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "inventory_relative_change": {"type": "number", "minimum": 0, "maximum": 0.2},
    "gates": {
      "type": "object",
      "required": ["candidate_genome_bound", "derived_physics_hash_bound",
        "field_artifact_bound", "beam_power_matches_genome",
        "beam_voltage_matches_genome", "beam_fractions_match_genome",
        "profile_assumption_is_explicit_non_authoritative",
        "external_backend_license_resolved", "nonzero_candidate_neutral_density",
        "monte_carlo_inventory_convergence"],
      "properties": {
        "external_backend_license_resolved": {"const": false},
        "nonzero_candidate_neutral_density": {"const": true},
        "monte_carlo_inventory_convergence": {"const": true}
      }
    },
    "source_artifacts": {"type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "object", "required": ["artifact_id", "artifact_hash"],
        "properties": {"artifact_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"$ref": "#/$defs/hash"}}}},
    "evidence_tasks": {"type": "array", "minItems": 6},
    "claim_boundary": {"type": "string", "minLength": 300},
    "result_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
