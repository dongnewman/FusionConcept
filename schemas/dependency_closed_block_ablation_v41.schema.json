      "properties": {
        "complete_compatible_assembly_count": {"const": 1129},
        "source_v40_structural_rejection_count": {"const": 141},
        "target_structurally_coupled_module_count": {"const": 23},
        "accepted_dependency_closed_trial_count": {"const": 141},
        "unresolved_dependency_closed_trial_count": {"const": 0},
        "matched_single_layer_comparison_count": {"type": "integer", "minimum": 0, "maximum": 141},
        "coupled_block_comparison_count": {"type": "integer", "minimum": 0, "maximum": 141},
        "raw_gate_variation_trial_count": {"type": "integer", "minimum": 0, "maximum": 141},
        "new_numerical_formula_implemented": {"const": false},
        "single_module_absolute_physical_causality_claimed": {"const": false},
        "physical_infeasibility_claimed": {"const": false},
        "gate_credit_authorized_count": {"const": 0},
        "medium_fidelity_authorized_count": {"const": 0},
        "old_domain_scale_up_authorized": {"const": false},
        "promotion_count": {"const": 0}
