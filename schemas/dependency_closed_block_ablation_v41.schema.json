        "minimum_dependency_closed_pair_selection",
        "paired_halton_sample_fixed",
        "new_numerical_formula_implemented"
      ],
      "properties": {
        "complete_compatible_assembly_count": {"const": 1129},
        "source_v40_structural_rejection_count": {"const": 141},
        "target_structurally_coupled_module_count": {"const": 23},
        "complete_compatible_assembly_search": {"const": true},
        "minimum_dependency_closed_pair_selection": {"const": true},
        "paired_halton_sample_fixed": {"const": true},
        "new_numerical_formula_implemented": {"const": false}
