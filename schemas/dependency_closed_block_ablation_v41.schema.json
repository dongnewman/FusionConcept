      "properties": {
        "single_module_absolute_physical_causality_claimed": {"const": false},
        "physical_infeasibility_claimed": {"const": false},
        "gate_credit_authorized_count": {"const": 0},
        "medium_fidelity_authorized_count": {"const": 0},
        "old_domain_scale_up_authorized": {"const": false},
        "promotion_count": {"const": 0},
