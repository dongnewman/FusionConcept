        "source_v40_structural_rejection_count",
        "target_structurally_coupled_module_count",
        "accepted_dependency_closed_trial_count",
        "unresolved_dependency_closed_trial_count",
        "matched_single_layer_comparison_count",
        "coupled_block_comparison_count",
        "raw_gate_variation_trial_count",
        "new_numerical_formula_implemented",
        "gate_credit_authorized_count",
        "medium_fidelity_authorized_count",
