{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/physical_realization_v92.schema.json",
  "title": "PhysicalRealizationV92",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "candidate_id", "candidate_hash", "topology_hash", "isomorphism_hash", "genome_hash", "basis_hash", "source_solver_input_hash", "coordinate_system", "scales", "regions", "oriented_surfaces", "volume_meshes", "wall_meshes", "field_sources", "profiles", "initial_conditions", "interface_conditions", "applicability_obligations", "structural_gene_consumption", "basis_consumption", "qualification", "claim_boundary", "realization_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_id": {"const": "fusionconceptai-v92-hifi-closure-20260828"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "topology_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "isomorphism_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "genome_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "basis_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_solver_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate_system": {"type": "object", "required": ["type", "origin_m", "axes", "handedness", "length_unit"]},
    "scales": {"type": "object"},
    "regions": {"type": "array", "minItems": 6, "items": {"type": "object", "required": ["region_id", "region_type", "dimension", "source_nodes", "coordinate_map"]}},
    "oriented_surfaces": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["surface_id", "surface_type", "orientation", "coordinate_map", "surface_hash"]}},
    "volume_meshes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "geometry_mesh_v92.schema.json"}},
    "wall_meshes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "geometry_mesh_v92.schema.json"}},
    "field_sources": {"type": "array", "minItems": 1, "items": {"$ref": "field_source_v92.schema.json"}},
    "profiles": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "initial_conditions": {"type": "object"},
    "interface_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "interface_condition_v92.schema.json"}},
    "applicability_obligations": {"type": "object", "required": ["declared_operators", "state_variables", "region_dimensions", "boundary_conditions", "interface_conditions", "field_semantics", "evidence_obligations", "solver_input_compatibility"]},
    "structural_gene_consumption": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["gene", "consumers"]}},
    "basis_consumption": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "required": ["basis_index", "consumers"]}},
    "qualification": {"type": "object", "required": ["status", "first_blocker", "all_blockers", "structural_gene_consumption_count", "expected_structural_gene_consumption_count", "basis_consumption_count"], "properties": {"status": {"enum": ["pass", "fail"]}}},
    "claim_boundary": {"type": "string", "minLength": 1},
    "realization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
