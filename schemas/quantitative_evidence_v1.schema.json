{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmc.local/schemas/quantitative-evidence-v1.json",
  "title": "LMC quantitative evidence table v1",
  "description": "Versioned, append-only numerical and explicit-gap evidence records. Values retain their reported source class, applicability, uncertainty statement, verification status, and promotion-credit boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "created_on",
    "base_catalogs",
    "citation_corrections",
    "evidence_entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "created_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "base_catalogs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_\\-]+\\.json$"
      }
    },
    "citation_corrections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "legacy_doi",
          "corrected_doi",
          "reason"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "legacy_doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]{4,9}/.+$"
          },
          "corrected_doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]{4,9}/.+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_entry"
      }
    }
  },
  "$defs": {
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "quantity_name",
        "family",
        "gate_ids",
        "source_ids",
        "evidence_provenance",
        "value_kind",
        "unit",
        "nominal_value",
        "lower_bound",
        "upper_bound",
        "qualitative_value",
        "operating_condition",
        "definition",
        "location",
        "verification_status",
        "transferability",
        "claim_boundary",
        "reported_text",
        "promotion_credit",
        "uncertainty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,95}$"
        },
        "quantity_name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          }
        },
        "evidence_provenance": {
          "enum": [
            "measured",
            "inferred",
            "model_calibrated",
            "searched_hypothesis",
            "no_direct_measurement"
          ]
        },
        "value_kind": {
          "enum": [
            "point",
            "range",
            "lower_bound",
            "upper_bound",
            "qualitative",
            "missing"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "nominal_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "lower_bound": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper_bound": {
          "type": [
            "number",
            "null"
          ]
        },
        "qualitative_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "operating_condition": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "metadata_only",
            "title_abstract",
            "catalog_summary",
            "full_text_verified"
          ]
        },
        "transferability": {
          "type": "string",
          "minLength": 1
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        },
        "reported_text": {
          "type": "string",
          "minLength": 1
        },
        "promotion_credit": {
          "type": "boolean"
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "enum": [
                "reported_range",
                "reported_lower_bound",
                "reported_upper_bound",
                "model_range",
                "qualitative",
                "not_reported",
                "missing_evidence"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "point"
              }
            },
            "required": [
              "value_kind"
            ]
          },
          "then": {
            "properties": {
              "nominal_value": {
                "type": "number"
              },
              "qualitative_value": {
                "const": null
              }
            },
            "required": [
              "nominal_value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "range"
              }
            },
            "required": [
              "value_kind"
            ]
          },
          "then": {
            "properties": {
              "lower_bound": {
                "type": "number"
              },
              "upper_bound": {
                "type": "number"
              },
              "qualitative_value": {
                "const": null
              }
            },
            "required": [
              "lower_bound",
              "upper_bound"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "lower_bound"
              }
            },
            "required": [
              "value_kind"
            ]
          },
          "then": {
            "properties": {
              "lower_bound": {
                "type": "number"
              },
              "upper_bound": {
                "const": null
              },
              "qualitative_value": {
                "const": null
              }
            },
            "required": [
              "lower_bound"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "upper_bound"
              }
            },
            "required": [
              "value_kind"
            ]
          },
          "then": {
            "properties": {
              "lower_bound": {
                "const": null
              },
              "upper_bound": {
                "type": "number"
              },
              "qualitative_value": {
                "const": null
              }
            },
            "required": [
              "upper_bound"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "qualitative"
              }
            },
            "required": [
              "value_kind"
            ]
          },
          "then": {
            "properties": {
              "nominal_value": {
                "const": null
              },
              "lower_bound": {
                "const": null
              },
              "upper_bound": {
                "const": null
              },
              "qualitative_value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "qualitative_value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "missing"
              }
            },
            "required": [
              "value_kind"
            ]
          },
          "then": {
            "properties": {
              "nominal_value": {
                "const": null
              },
              "lower_bound": {
                "const": null
              },
              "upper_bound": {
                "const": null
              },
              "qualitative_value": {
                "const": null
              },
              "unit": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
