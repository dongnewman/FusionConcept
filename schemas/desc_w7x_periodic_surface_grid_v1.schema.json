{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desc_w7x_periodic_surface_grid_v1.schema.json",
  "type": "object",
  "required": ["schema_version", "status", "design_id", "genome_physics_hash",
    "surface_source_id", "surface_source_hash", "source_solver_input_hash",
    "source_solver_result_hash", "coordinate_system", "position_components",
    "vector_components", "covered_domain_ids",
    "field_periods", "field_period_angle_rad", "rho_levels",
    "theta_values_rad", "zeta_values_rad", "node_count", "node_rho",
    "node_theta_rad", "node_zeta_rad", "x_rpz", "b_t", "e_rho_m",
    "e_theta_m", "e_zeta_m", "sqrt_g_m3", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "pass"},
    "genome_physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "surface_source_id": {"const": "desc_w7x_periodic_surface_grid_v1"},
    "surface_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_solver_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_solver_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate_system": {"const": "desc_flux_coordinates_periodic_3d"},
    "position_components": {"const": ["R_m", "phi_rad", "Z_m"]},
    "vector_components": {"const": ["R", "phi", "Z"]},
    "covered_domain_ids": {"const": ["desc_w7x_core"]},
    "field_periods": {"const": 5},
    "field_period_angle_rad": {"type": "number", "exclusiveMinimum": 0},
    "rho_levels": {"type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number"}},
    "theta_values_rad": {"type": "array", "minItems": 33, "maxItems": 33,
      "items": {"type": "number"}},
    "zeta_values_rad": {"type": "array", "minItems": 17, "maxItems": 17,
      "items": {"type": "number"}},
    "node_count": {"const": 2244},
    "node_rho": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "node_theta_rad": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "node_zeta_rad": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "x_rpz": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "b_t": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "e_rho_m": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "e_theta_m": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "e_zeta_m": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "sqrt_g_m3": {"type": "array", "minItems": 2244, "maxItems": 2244},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
