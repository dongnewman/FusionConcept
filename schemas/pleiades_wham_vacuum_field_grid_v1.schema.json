{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pleiades_wham_vacuum_field_grid_v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "runner_version",
    "design_id",
    "genome_physics_hash",
    "field_source_id",
    "field_source_hash",
    "coordinate_system",
    "covered_domain_ids",
    "solver_input_hash",
    "source_solver_result_hash",
    "radial_grid_m",
    "axial_grid_m",
    "br_t",
    "bphi_t",
    "bz_t",
    "field_minimum_t",
    "field_maximum_t",
    "claim_boundary",
    "result_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "pass"},
    "runner_version": {"const": "pleiades_wham_candidate_bound_field_grid_v1"},
    "genome_physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "field_source_id": {"const": "pleiades_wham_vacuum_field_grid_v1"},
    "field_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate_system": {"const": "cylindrical_axisymmetric"},
    "covered_domain_ids": {"const": ["pleiades_wham_isotropic_core"]},
    "solver_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_solver_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "radial_grid_m": {"type": "array", "minItems": 31, "maxItems": 31, "items": {"type": "number"}},
    "axial_grid_m": {"type": "array", "minItems": 81, "maxItems": 81, "items": {"type": "number"}},
    "br_t": {"type": "array", "minItems": 81, "maxItems": 81},
    "bphi_t": {"type": "array", "minItems": 81, "maxItems": 81},
    "bz_t": {"type": "array", "minItems": 81, "maxItems": 81},
    "field_minimum_t": {"type": "number", "exclusiveMinimum": 0},
    "field_maximum_t": {"type": "number", "exclusiveMinimum": 0},
    "claim_boundary": {"type": "string", "minLength": 1},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
