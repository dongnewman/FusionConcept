{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/solver_result_envelope_v1.schema.json",
  "title": "SolverResultEnvelopeV1",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "physics_hash", "manifest_hash", "input_hash",
    "software_hash", "container_hash", "result_hash", "status", "convergence_status",
    "residual_history", "state_trajectory", "conservation_slots", "resolution",
    "error_estimates", "module_results", "evidence_ceiling", "unsupported_reasons"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "software_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "container_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pass", "fail", "unknown", "unsupported"]},
    "convergence_status": {"type": "string", "minLength": 1},
    "residual_history": {"type": "array"},
    "state_trajectory": {"type": "object"},
    "conservation_slots": {"type": "array"},
    "resolution": {"type": "object"},
    "error_estimates": {"type": "object"},
    "module_results": {"type": "array"},
    "evidence_ceiling": {"type": "string", "minLength": 1},
    "unsupported_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
