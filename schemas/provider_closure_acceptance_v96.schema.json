{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fusionconceptai://schemas/provider_closure_acceptance_v96.schema.json",
  "title": "FusionConceptAI v96 physical provider closure acceptance",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "software_controls_status",
    "selector_acceptance",
    "execution_order",
    "reference_control_count",
    "generated_candidate_count",
    "closure_246_retest_count",
    "known_positive_recall",
    "candidate_status_histogram",
    "provider_registry",
    "provider_coverage",
    "blocker_statistics",
    "before_after",
    "million_no_proxy_replay",
    "controls",
    "conclusions",
    "physical_conclusion_expanded",
    "claim_boundary",
    "acceptance_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "protocol_id": { "const": "fusionconceptai-v96-physical-provider-closure-20260828" },
    "status": { "enum": ["pass", "fail"] },
    "software_controls_status": { "enum": ["pass", "fail"] },
    "selector_acceptance": {
      "enum": ["pass", "blocked_reference_control_false_negative", "blocked_million_replay", "blocked_software_controls"]
    },
    "execution_order": { "type": "array", "minItems": 5 },
    "reference_control_count": { "type": "integer", "minimum": 0 },
    "generated_candidate_count": { "type": "integer", "minimum": 0 },
    "closure_246_retest_count": { "type": "integer", "minimum": 0 },
    "known_positive_recall": { "type": "object" },
    "candidate_status_histogram": { "type": "object" },
    "provider_registry": { "type": "object" },
    "provider_coverage": { "type": "object" },
    "blocker_statistics": { "type": "object" },
    "before_after": { "type": "object" },
    "million_no_proxy_replay": { "type": "object" },
    "controls": { "type": "object" },
    "conclusions": { "type": "object" },
    "physical_conclusion_expanded": { "const": false },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "acceptance_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": true
}
