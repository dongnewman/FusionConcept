{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/current_potential_inverse_request_v1.schema.json",
  "title": "CurrentPotentialInverseRequestV1",
  "type": "object",
  "required": [
    "schema_version",
    "source_request_hash",
    "structure_hash",
    "source_design_hash",
    "source_basis_override_hash",
    "winding_model",
    "active_coefficient_indices",
    "target_rotational_transform",
    "theta_count",
    "phi_count",
    "acquisition_toroidal_turns",
    "acquisition_steps_per_turn",
    "maximum_iterations",
    "finite_difference_step",
    "trust_radius",
    "tikhonov_regularization",
    "inverse_solver_id",
    "next_request_sampling_only",
    "retroactive_feasibility_credit",
    "request_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "structure_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_design_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_basis_override_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "winding_model": {"const": "winding_surface_current_potential_level_set_filaments_v7"},
    "active_coefficient_indices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "target_rotational_transform": {"type": "number", "exclusiveMinimum": 0},
    "theta_count": {"type": "integer", "minimum": 2},
    "phi_count": {"type": "integer", "minimum": 2},
    "acquisition_toroidal_turns": {"type": "integer", "minimum": 1},
    "acquisition_steps_per_turn": {"type": "integer", "minimum": 1},
    "axis_locator_refinement_levels": {"type": "integer", "minimum": 1},
    "axis_locator_maximum_closure_residual": {"type": "number", "exclusiveMinimum": 0},
    "maximum_iterations": {"type": "integer", "minimum": 0},
    "finite_difference_step": {"type": "number", "exclusiveMinimum": 0},
    "trust_radius": {"type": "number", "exclusiveMinimum": 0},
    "tikhonov_regularization": {"type": "number", "exclusiveMinimum": 0},
    "inverse_solver_id": {"const": "candidate_bound_regularized_current_potential_gauss_newton_v1"},
    "acquisition_model_id": {"const": "candidate_biot_savart_periodic_axis_fieldline_acquisition_v2"},
    "next_request_sampling_only": {"const": true},
    "retroactive_feasibility_credit": {"const": false},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
