{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconcept.ai/schemas/universal_multitopology_acceptance_v90.schema.json",
  "title": "UniversalMultitopologyAcceptanceV90",
  "type": "object",
  "required": [
    "schema_version",
    "acceptance_id",
    "implementation_acceptance_status",
    "credible_large_range_search_claim_status",
    "credible_large_range_search_claim_authorized",
    "generated_non_sentinel_vertical_slices",
    "sentinel_results",
    "negative_controls",
    "status_histogram",
    "layer_counts",
    "routing_firewall",
    "retroactive_feasibility_credit",
    "unmet_physical_engineering_experimental_novelty_boundaries",
    "claim_boundary",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "acceptance_id": {"const": "universal_multitopology_device_chain_v90"},
    "implementation_acceptance_status": {"enum": ["pass", "fail"]},
    "credible_large_range_search_claim_status": {"const": "fail"},
    "credible_large_range_search_claim_authorized": {"const": false},
    "generated_non_sentinel_vertical_slices": {"type": "array", "minItems": 2},
    "sentinel_results": {"type": "array", "minItems": 2},
    "retroactive_feasibility_credit": {"const": false},
    "unmet_physical_engineering_experimental_novelty_boundaries": {
      "type": "array",
      "minItems": 1
    },
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
