{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fusionconceptai://schemas/unified_filter_acceptance_v95.schema.json",
  "title": "FusionConceptAI v95 unified filter acceptance",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "software_controls_status",
    "selector_acceptance",
    "execution_order",
    "reference_control_count",
    "generated_candidate_count",
    "closure_246_retest_count",
    "known_positive_recall",
    "candidate_status_histogram",
    "gate_blockers",
    "before_after",
    "controls",
    "conclusions",
    "physical_conclusion_expanded",
    "claim_boundary",
    "acceptance_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "protocol_id": { "const": "fusionconceptai-v95-unified-reference-candidate-filter-20260828" },
    "status": { "enum": ["pass", "fail"] },
    "software_controls_status": { "enum": ["pass", "fail"] },
    "selector_acceptance": { "enum": ["pass", "blocked_reference_control_false_negative"] },
    "execution_order": {
      "const": ["reference_controls", "generated_candidates"]
    },
    "reference_control_count": { "type": "integer", "minimum": 0 },
    "generated_candidate_count": { "type": "integer", "minimum": 0 },
    "closure_246_retest_count": { "type": "integer", "minimum": 0 },
    "known_positive_recall": { "type": "object" },
    "candidate_status_histogram": { "type": "object" },
    "gate_blockers": { "type": "object" },
    "before_after": { "type": "object" },
    "controls": { "type": "object" },
    "conclusions": { "type": "object" },
    "physical_conclusion_expanded": { "const": false },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "acceptance_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": true
}
