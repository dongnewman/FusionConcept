{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/engineering_result_envelope_v1.schema.json",
  "title": "EngineeringResultEnvelopeV1",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "physics_hash", "manifest_hash",
    "state_result_hash", "transport_result_hash", "status", "output_roles",
    "checks", "recirculating_power", "evidence_ceiling", "unknown_reasons",
    "result_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_result_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "transport_result_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "status": {"enum": ["pass", "fail", "unknown", "unsupported"]},
    "output_roles": {"type": "array"},
    "checks": {"type": "array"},
    "recirculating_power": {"type": "object"},
    "evidence_ceiling": {"type": "string", "minLength": 1},
    "unknown_reasons": {"type": "array", "items": {"type": "string"}},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
