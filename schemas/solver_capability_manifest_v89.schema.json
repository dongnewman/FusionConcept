{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconcept.ai/schemas/solver_capability_manifest_v89.schema.json",
  "title": "SolverCapabilityManifestV89",
  "type": "object",
  "required": ["schema_version", "manifest_id", "operator_ids", "state_variables", "spatial_dimensions", "boundary_kinds", "time_semantics", "validity_domain", "supported_observables", "numerical_tolerances", "software_hash", "container_hash", "mesh_hash", "independence_group", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "operator_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "state_variables": {"type": "array", "items": {"type": "string"}},
    "spatial_dimensions": {"type": "array", "minItems": 1, "items": {"enum": ["0d", "1d", "2d", "3d"]}},
    "boundary_kinds": {"type": "array", "items": {"type": "string"}},
    "time_semantics": {"type": "array", "items": {"type": "string"}},
    "validity_domain": {"type": "object"},
    "supported_observables": {"type": "array"},
    "numerical_tolerances": {"type": "object"},
    "software_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "container_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mesh_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "independence_group": {"type": "string"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
