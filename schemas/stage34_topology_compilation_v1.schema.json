{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/stage34_topology_compilation_v1.schema.json",
  "title": "Stage 3/4 Topology Compilation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_binding_hash", "state_package_hash", "grammar_hash", "status", "classification_code", "stage3_bindings", "stage4_bindings", "interface_flux_pairs", "audits", "reasons", "compilation_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_binding_hash": {"$ref": "#/$defs/hash"},
    "state_package_hash": {"$ref": "#/$defs/hash"},
    "grammar_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["pass", "fail", "unknown", "unsupported"]},
    "classification_code": {"type": "string", "minLength": 1},
    "stage3_bindings": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "stage4_bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "interface_flux_pairs": {"type": "array", "items": {"type": "object"}},
    "audits": {"type": "object"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "compilation_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
