{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmc.local/schemas/cross_topology_coupled_plasma_balance_v1.schema.json",
  "title": "Cross-topology coupled plasma balance v1",
  "type": "object",
  "required": ["schema_version", "stage", "operator_principle",
    "source_artifacts", "controls", "summary", "claim_ceiling",
    "claim_boundary", "deterministic_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "cross_topology_coupled_plasma_balance_v1"},
    "operator_principle": {"type": "string", "minLength": 300},
    "source_artifacts": {"type": "array", "minItems": 6, "maxItems": 6,
      "items": {"type": "object", "required": ["artifact_id", "artifact_hash"],
        "properties": {"artifact_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"$ref": "#/$defs/hash"}},
        "additionalProperties": false}},
    "controls": {"type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/control"}},
    "summary": {
      "type": "object",
      "required": ["control_count", "open_field_control_count",
        "closed_field_control_count", "equation_count",
        "particle_equation_count", "thermal_energy_equation_count",
        "required_rate_term_count", "observed_rate_term_count",
        "c2_authorized_rate_term_count", "passed_equation_count",
        "failed_equation_count", "unknown_equation_count", "complete_c2_count",
        "new_candidate_count", "promotion_count"],
      "properties": {
        "control_count": {"const": 3},
        "open_field_control_count": {"const": 2},
        "closed_field_control_count": {"const": 2},
        "equation_count": {"const": 9},
        "particle_equation_count": {"const": 6},
        "thermal_energy_equation_count": {"const": 3},
        "required_rate_term_count": {"const": 58},
        "observed_rate_term_count": {"const": 0},
        "c2_authorized_rate_term_count": {"const": 0},
        "passed_equation_count": {"const": 0},
        "failed_equation_count": {"const": 0},
        "unknown_equation_count": {"const": 9},
        "complete_c2_count": {"const": 0},
        "new_candidate_count": {"const": 0},
        "promotion_count": {"const": 0}
      },
      "additionalProperties": false
    },
    "claim_ceiling": {"const": "C2_coupled_particle_and_plasma_energy_balance_component_only"},
    "claim_boundary": {"type": "string", "minLength": 900},
    "deterministic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "term": {
      "type": "object",
      "required": ["term_id", "equation_id", "domain_id", "species_id",
        "conserved_quantity", "side", "unit", "mechanism_class",
        "description", "upstream_component_ids"],
      "properties": {
        "term_id": {"type": "string", "minLength": 1},
        "equation_id": {"type": "string", "minLength": 1},
        "domain_id": {"type": "string", "minLength": 1},
        "species_id": {"type": "string", "minLength": 1},
        "conserved_quantity": {"enum": ["particle", "thermal_energy"]},
        "side": {"enum": ["storage", "source", "loss", "signed_exchange"]},
        "unit": {"enum": ["s^-1", "W"]},
        "mechanism_class": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 30},
        "upstream_component_ids": {"type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "equation": {
      "type": "object",
      "required": ["equation_id", "domain_id", "species_id",
        "conserved_quantity", "unit", "term_ids"],
      "properties": {
        "equation_id": {"type": "string", "minLength": 1},
        "domain_id": {"type": "string", "minLength": 1},
        "species_id": {"type": "string", "minLength": 1},
        "conserved_quantity": {"enum": ["particle", "thermal_energy"]},
        "unit": {"enum": ["s^-1", "W"]},
        "term_ids": {"type": "array", "minItems": 4,
          "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "required": ["compiler_version", "design_id", "genome_physics_hash",
        "fuel_declaration", "operating_mode", "population_domain_ids",
        "required_initial_species_ids", "has_open_field_regions",
        "has_closed_field_regions", "equations", "terms", "source_ids",
        "evidence_tasks", "claim_ceiling", "problem_hash"],
      "properties": {
        "compiler_version": {"const": "coupled_plasma_balance_compiler_v1.0.0"},
        "design_id": {"type": "string", "minLength": 1},
        "genome_physics_hash": {"$ref": "#/$defs/hash"},
        "fuel_declaration": {"type": "string", "minLength": 1},
        "operating_mode": {"type": "string", "minLength": 1},
        "population_domain_ids": {"type": "array", "minItems": 1,
          "items": {"type": "string"}, "uniqueItems": true},
        "required_initial_species_ids": {"type": "array", "minItems": 2,
          "items": {"type": "string"}, "uniqueItems": true},
        "has_open_field_regions": {"type": "boolean"},
        "has_closed_field_regions": {"type": "boolean"},
        "equations": {"type": "array", "minItems": 3,
          "items": {"$ref": "#/$defs/equation"}},
        "terms": {"type": "array", "minItems": 18,
          "items": {"$ref": "#/$defs/term"}},
        "source_ids": {"type": "array", "contains": {"const": "process_physics_2015"}},
        "evidence_tasks": {"type": "array", "minItems": 18,
          "items": {"type": "string"}, "uniqueItems": true},
        "claim_ceiling": {"const": "C2_coupled_particle_and_plasma_energy_balance_component_only"},
        "problem_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["design_id", "genome_physics_hash", "problem_hash",
        "required_term_count", "observed_term_count",
        "c2_authorized_term_count", "equation_statuses",
        "equation_residuals", "equation_relative_residuals",
        "passed_equation_ids", "failed_equation_ids", "unknown_equation_ids",
        "status", "complete_c2_balance_authorized", "promotion_authorized",
        "evidence_tasks", "warnings", "assessment_hash"],
      "properties": {
        "genome_physics_hash": {"$ref": "#/$defs/hash"},
        "problem_hash": {"$ref": "#/$defs/hash"},
        "observed_term_count": {"const": 0},
        "c2_authorized_term_count": {"const": 0},
        "passed_equation_ids": {"type": "array", "maxItems": 0},
        "failed_equation_ids": {"type": "array", "maxItems": 0},
        "unknown_equation_ids": {"type": "array", "minItems": 3},
        "status": {"const": "unknown"},
        "complete_c2_balance_authorized": {"const": false},
        "promotion_authorized": {"const": false},
        "assessment_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "control": {
      "type": "object",
      "required": ["design_id", "source_genome_artifact_id",
        "source_genome_artifact_hash", "diagnostic_legacy_family_label",
        "family_label_used_for_operator_selection", "problem", "assessment",
        "mechanism_census", "inventory_is_rate_evidence",
        "prompt_loss_fraction_is_boundary_flux_evidence",
        "charged_fusion_power_is_deposited_heating_evidence",
        "fuel_bremsstrahlung_is_complete_radiation_evidence",
        "complete_c2", "promotion_authorized"],
      "properties": {
        "source_genome_artifact_hash": {"$ref": "#/$defs/hash"},
        "family_label_used_for_operator_selection": {"const": false},
        "problem": {"$ref": "#/$defs/problem"},
        "assessment": {"$ref": "#/$defs/assessment"},
        "mechanism_census": {"type": "object", "minProperties": 12},
        "inventory_is_rate_evidence": {"const": false},
        "prompt_loss_fraction_is_boundary_flux_evidence": {"const": false},
        "charged_fusion_power_is_deposited_heating_evidence": {"const": false},
        "fuel_bremsstrahlung_is_complete_radiation_evidence": {"const": false},
        "complete_c2": {"const": false},
        "promotion_authorized": {"const": false}
      }
    }
  }
}
