{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/species_state_contract_v1.schema.json",
  "title": "SpeciesStateContractV1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "fuel_declaration", "species_records", "reaction_channels", "status", "contract_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fuel_declaration": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "unsupported"]},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "species_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["species_id", "mass_amu", "charge_state", "role", "region_ids", "density_profile_binding", "temperature_profile_binding", "declaration_basis"],
        "properties": {
          "species_id": {"type": "string", "minLength": 1},
          "mass_amu": {"type": "number", "exclusiveMinimum": 0},
          "charge_state": {"type": "integer"},
          "role": {"type": "string", "minLength": 1},
          "region_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "density_profile_binding": {"type": "string", "minLength": 1},
          "temperature_profile_binding": {"type": "string", "minLength": 1},
          "declaration_basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "reaction_channels": {"type": "array", "minItems": 1}
  }
}
