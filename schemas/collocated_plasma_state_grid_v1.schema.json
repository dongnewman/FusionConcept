{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmc.local/schemas/collocated_plasma_state_grid_v1.schema.json",
  "title": "Candidate-bound collocated plasma state grid v1",
  "type": "object",
  "required": ["design_id", "genome_physics_hash", "domain_id",
    "resolution_label", "resolution_rank", "cell_volumes_m3",
    "species_density_m3", "temperature_parallel_j",
    "temperature_perpendicular_j", "distribution_kinds",
    "runtime_state_assessment_hash", "runtime_state_c2_authorized",
    "cellwise_quasi_neutrality_verified",
    "runtime_inventory_consistency_verified", "fully_ionized_fuel_verified",
    "optically_thin_bremsstrahlung_verified", "source_kind",
    "source_artifact_id", "source_artifact_hash", "source_result_hash",
    "candidate_binding_verified", "resolution_verified",
    "applicability_verified", "fidelity", "source_solver_status"],
  "properties": {
    "design_id": {"type": "string", "minLength": 1},
    "genome_physics_hash": {"$ref": "#/$defs/hash"},
    "domain_id": {"type": "string", "minLength": 1},
    "resolution_label": {"type": "string", "minLength": 1},
    "resolution_rank": {"type": "integer", "minimum": 1},
    "cell_volumes_m3": {"$ref": "#/$defs/positive_profile"},
    "species_density_m3": {"$ref": "#/$defs/nonnegative_profiles"},
    "temperature_parallel_j": {"$ref": "#/$defs/positive_profiles"},
    "temperature_perpendicular_j": {"$ref": "#/$defs/positive_profiles"},
    "distribution_kinds": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"enum": ["maxwellian", "bi_maxwellian",
        "tabulated", "particle_ensemble", "unknown"]}
    },
    "runtime_state_assessment_hash": {"$ref": "#/$defs/hash"},
    "runtime_state_c2_authorized": {"type": "boolean"},
    "cellwise_quasi_neutrality_verified": {"type": "boolean"},
    "runtime_inventory_consistency_verified": {"type": "boolean"},
    "fully_ionized_fuel_verified": {"type": "boolean"},
    "optically_thin_bremsstrahlung_verified": {"type": "boolean"},
    "source_kind": {"enum": ["candidate_solver", "measured", "proxy",
      "manufactured", "structural"]},
    "source_artifact_id": {"type": "string", "minLength": 1},
    "source_artifact_hash": {"$ref": "#/$defs/hash"},
    "source_result_hash": {"$ref": "#/$defs/hash"},
    "candidate_binding_verified": {"type": "boolean"},
    "resolution_verified": {"type": "boolean"},
    "applicability_verified": {"type": "boolean"},
    "fidelity": {"type": "integer", "minimum": 0},
    "source_solver_status": {"enum": ["pass", "fail", "unknown", "error"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive_profile": {"type": "array", "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}},
    "nonnegative_profiles": {"type": "object", "minProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 1,
        "items": {"type": "number", "minimum": 0}}},
    "positive_profiles": {"type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/positive_profile"}}
  }
}
