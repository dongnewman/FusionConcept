{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/hierarchical_energy_target_search_v1.schema.json",
  "title": "Hierarchical Energy Target Search V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "objective_specs", "entries", "priority_front_binding_hashes", "target_shortfall_binding_hashes", "c2_terminated_binding_hashes", "evidence_queue_binding_hashes", "topology_rejected_binding_hashes", "scalar_score_used", "search_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "objective_specs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/objective"}},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "priority_front_binding_hashes": {"$ref": "#/$defs/hashSet"},
    "target_shortfall_binding_hashes": {"$ref": "#/$defs/hashSet"},
    "c2_terminated_binding_hashes": {"$ref": "#/$defs/hashSet"},
    "evidence_queue_binding_hashes": {"$ref": "#/$defs/hashSet"},
    "topology_rejected_binding_hashes": {"$ref": "#/$defs/hashSet"},
    "scalar_score_used": {"const": false},
    "search_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["objective_id", "account_id", "sense", "tier", "target", "scale", "unit", "objective_hash"],
      "properties": {
        "objective_id": {"type": "string", "minLength": 1}, "account_id": {"type": "string", "minLength": 1},
        "sense": {"enum": ["minimize", "maximize"]}, "tier": {"type": "integer", "minimum": 1},
        "target": {"type": "number"}, "scale": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1}, "objective_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_binding_hash", "state_package_hash", "topology_compilation_hash", "decision_hash", "disposition", "objective_coordinates", "evidence_tasks", "entry_hash"],
      "properties": {
        "candidate_binding_hash": {"$ref": "#/$defs/hash"}, "state_package_hash": {"$ref": "#/$defs/hash"},
        "topology_compilation_hash": {"$ref": "#/$defs/hash"}, "decision_hash": {"$ref": "#/$defs/hash"},
        "disposition": {"enum": ["rankable", "target_shortfall", "c2_terminated", "evidence_queue", "topology_rejected"]},
        "objective_coordinates": {"type": "array", "items": {"type": "object"}},
        "evidence_tasks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "entry_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
