{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/external_resource_requirement_manifest_v1.schema.json",
  "title": "ExternalResourceRequirementManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "physics_hash", "solve_manifest_hash", "requirements", "candidate_input_blockers", "status", "claim_boundary", "requirement_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "solve_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirements": {"type": "array", "items": {"type": "object"}},
    "candidate_input_blockers": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["requirements_complete", "unknown_candidate_input_incomplete", "not_applicable"]},
    "claim_boundary": {"type": "string"},
    "requirement_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
