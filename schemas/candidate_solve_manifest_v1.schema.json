{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.local/schemas/candidate_solve_manifest_v1.schema.json",
  "title": "CandidateSolveManifestV1",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "physics_hash", "regions", "mesh",
    "state_variables", "capability_declarations", "module_bindings", "boundaries",
    "sources_sinks", "time_mode", "initial_conditions", "numerical_tolerances",
    "discretization_levels", "required_outputs", "applicability_scope", "parameters",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "physics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "regions": {"type": "array", "minItems": 1},
    "mesh": {"type": "object"},
    "state_variables": {"type": "array"},
    "capability_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "declared_by_module_ids", "declaration_basis"]
      }
    },
    "module_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id", "capability_id", "operator_id", "state_ids", "evidence_ceiling"]
      }
    },
    "boundaries": {"type": "array"},
    "sources_sinks": {"type": "array"},
    "time_mode": {"enum": ["steady", "transient", "pulsed"]},
    "initial_conditions": {"type": "object"},
    "numerical_tolerances": {"type": "object"},
    "discretization_levels": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 2}},
    "required_outputs": {"type": "array", "minItems": 1},
    "applicability_scope": {
      "type": "object",
      "required": ["status", "unsupported_reasons", "routing_basis", "nonrouting_fields"],
      "properties": {"status": {"enum": ["applicable", "unsupported"]}}
    },
    "parameters": {"type": "object"}
  }
}
