{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmc.local/schemas/confinement-genome-v61-overlay-1.0.0.json",
  "title": "LMC Confinement Genome v61 Regional Solver Overlay",
  "description": "Additive validation overlay for explicit v61 region, interface, and actuator solver declarations. The sealed confinement-genome-0.1.0 schema remains byte-stable.",
  "type": "object",
  "required": ["regional_solver_contract_v1"],
  "properties": {
    "regional_solver_contract_v1": {"$ref": "#/$defs/regional_contract"}
  },
  "$defs": {
    "regional_contract": {
      "type": "object",
      "required": ["schema_version", "generation_stage", "generator_id", "region_records", "interface_records", "actuator_sizing_records", "contract_hash"],
      "properties": {
        "generation_stage": {"const": "before_common_screen"},
        "generator_id": {"const": "regional_genome_grammar_v61"},
        "family_label_used": {"const": false},
        "region_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/explicit_region"}
        },
        "interface_records": {
          "type": "array",
          "items": {"$ref": "#/$defs/explicit_interface"}
        },
        "actuator_sizing_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/explicit_actuator"}
        },
        "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "basis": {"type": "string"}
      }
    },
    "profile_component": {
      "type": "object",
      "required": ["exponent", "unit"],
      "properties": {
        "axis_value_m3": {"type": "number", "exclusiveMinimum": 0},
        "edge_value_m3": {"type": "number", "exclusiveMinimum": 0},
        "axis_value_ev": {"type": "number", "exclusiveMinimum": 0},
        "edge_value_ev": {"type": "number", "exclusiveMinimum": 0},
        "exponent": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "explicit_region": {
      "type": "object",
      "required": ["region_id", "mesh", "state_profile"],
      "properties": {
        "region_id": {"$ref": "#/$defs/id"},
        "mesh": {
          "type": "object",
          "required": ["kind", "coordinate", "declared_levels", "region_volume_m3"],
          "properties": {
            "kind": {"const": "finite_volume"},
            "coordinate": {"const": "normalized_volume"},
            "declared_levels": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "integer", "minimum": 1}
            },
            "region_volume_m3": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "state_profile": {
          "type": "object",
          "required": ["coordinate", "basis", "particle_density", "temperature"],
          "properties": {
            "coordinate": {"const": "normalized_volume"},
            "basis": {"const": "edge_plus_axis_power_v1"},
            "particle_density": {"$ref": "#/$defs/profile_component"},
            "temperature": {"$ref": "#/$defs/profile_component"}
          }
        }
      }
    },
    "explicit_actuator": {
      "type": "object",
      "required": ["actuator_id", "target_region_id", "target_region_ids", "capability", "capabilities", "demand", "capacity", "unit", "positive_state_feasibility_scale", "operator_contract"],
      "properties": {
        "actuator_id": {"$ref": "#/$defs/id"},
        "target_region_id": {"$ref": "#/$defs/id"},
        "capability": {"type": "string", "minLength": 1},
        "demand": {"type": "number", "minimum": 0},
        "capacity": {"type": "number", "minimum": 0},
        "target_region_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unit": {"type": "string", "minLength": 1},
        "positive_state_feasibility_scale": {"type": "number", "minimum": 0, "maximum": 1},
        "operator_contract": {
          "type": "object",
          "required": ["operator_id", "capacity_jacobian_provider"],
          "properties": {
            "operator_id": {"const": "bounded_regional_actuator_v1"},
            "capacity_jacobian_provider": {"const": "analytic_box_constraint_jacobian_v1"}
          }
        }
      }
    },
    "explicit_interface": {
      "type": "object",
      "required": ["from_region_id", "to_region_id", "interface_id", "area_m2", "particle_transfer_volume_m3_s", "energy_transfer_volume_m3_s", "boundary_conditions", "operator_contract"],
      "properties": {
        "from_region_id": {"$ref": "#/$defs/id"},
        "to_region_id": {"$ref": "#/$defs/id"},
        "interface_id": {"$ref": "#/$defs/id"},
        "area_m2": {"type": "number", "exclusiveMinimum": 0},
        "particle_transfer_volume_m3_s": {"type": "number", "exclusiveMinimum": 0},
        "energy_transfer_volume_m3_s": {"type": "number", "exclusiveMinimum": 0},
        "boundary_conditions": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "object"}
        },
        "operator_contract": {
          "type": "object",
          "required": ["operator_id", "jacobian_provider"],
          "properties": {
            "operator_id": {"const": "finite_volume_two_point_flux_v1"},
            "jacobian_provider": {"const": "analytic_two_point_flux_jacobian_v1"}
          }
        }
      }
    }
  }
}
