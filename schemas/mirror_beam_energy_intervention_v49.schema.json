        "performance_ranking_authorized_count",
        "medium_fidelity_authorized_count", "promotion_count",
        "qd_cell_count", "qd_performance_selected_cell_count",
        "by_energy_keV"
      ],
      "properties": {
        "input_candidate_count": {"const": 2000},
        "mirror_candidate_count": {"const": 724},
        "mirror_assembly_count": {"const": 362},
        "beam_energy_level_count": {"const": 3},
        "trial_count": {"const": 2172},
        "fixed_non_beam_background_count": {"const": 2172},
        "beam_energy_gene_present_count": {"const": 2172},
        "nbi_beam_energy_synchronized_count": {"const": 2172},
        "source_complete_formula_consumed_gene_count": {"const": 2172},
        "unique_physics_hash_count": {"const": 2172},
        "current_evaluator_beam_invariant_count": {"const": 2172},
        "preregistered_tau_ratio_reproduced_count": {"const": 2172},
        "hundred_keV_v48_reproduction_count": {"const": 724},
        "nonbaseline_response_change_count": {"const": 1448},
        "source_domain_complete_count": {"const": 0},
        "performance_ranking_authorized_count": {"const": 0},
        "medium_fidelity_authorized_count": {"const": 0},
        "promotion_count": {"const": 0},
        "qd_cell_count": {"const": 1086},
        "qd_performance_selected_cell_count": {"const": 0}
      }
    },
    "next_actions": {"type": "array", "minItems": 5},
    "promotion_credit": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 700},
    "input_binding": {"type": "object"},
    "archives": {"type": "object"},
    "run_date": {"const": "2026-08-15"},
    "deterministic_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
