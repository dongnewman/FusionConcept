{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmc.local/schemas/frozen_acquisition_confirmation_v30.schema.json",
  "title": "Frozen acquisition confirmation v30",
  "type": "object",
  "required": [
    "schema_version", "run_date", "search_version", "stage", "result_hash",
    "input_binding", "benchmark_contract", "batch_summaries", "outcome",
    "archives", "claim_boundary", "promotion_credit", "runtime_measurements",
    "source_hashes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "search_version": { "const": "frozen_acquisition_confirmation_v30" },
    "stage": { "const": "five_batch_preregistered_qd_confirmation" },
    "result_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promotion_credit": {
      "type": "object",
      "required": ["medium_fidelity_authorized_count", "physics_evidence_level_change"],
      "properties": {
        "medium_fidelity_authorized_count": { "const": 0 },
        "physics_evidence_level_change": { "const": 0 }
      }
    }
  },
  "additionalProperties": true
}
